# Copy to .env for local development. Never commit real secrets.
PROOFTRAIL_ENVIRONMENT=development
PROOFTRAIL_DATABASE_URL=sqlite:///./data/prooftrail.db
PROOFTRAIL_SESSION_SECRET=change-this-secret-before-deploying
PROOFTRAIL_SESSION_COOKIE_NAME=prooftrail_session
PROOFTRAIL_SESSION_TTL_HOURS=168
PROOFTRAIL_COOKIE_SECURE=false
PROOFTRAIL_DEMO_MODE=true
PROOFTRAIL_ALLOW_SIGNUP=false
PROOFTRAIL_MAX_UPLOAD_MB=10
PROOFTRAIL_DATA_DIR=./data
PROOFTRAIL_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional OpenAI-compatible API; requests are made server-side only.
# PROOFTRAIL_OPENAI_COMPATIBLE_BASE_URL=https://api.openai.com/v1
# PROOFTRAIL_OPENAI_COMPATIBLE_API_KEY=replace-with-a-server-side-secret
# PROOFTRAIL_LLM_MODEL=gpt-4o-mini
# PROOFTRAIL_LLM_TIMEOUT_SECONDS=25
# Administrator bootstrap only when demo mode is disabled.
# PROOFTRAIL_ADMIN_EMAIL=admin@example.com
# PROOFTRAIL_ADMIN_PASSWORD=use-a-long-unique-password
# PROOFTRAIL_ADMIN_NAME=Workspace Administrator
